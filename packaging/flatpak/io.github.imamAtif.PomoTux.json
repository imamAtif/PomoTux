{
  "app-id": "io.github.imamAtif.PomoTux",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.9",
  "sdk": "org.kde.Sdk",
  "base": "io.qt.PySide.BaseApp",
  "base-version": "6.9",
  "command": "pomotux",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.Notifications",
    "--persist=.config/pomotux",
    "--persist=.local/share/pomotux"
  ],
  "build-options": {
    "env": {
      "BASEAPP_REMOVE_WEBENGINE": "1",
      "BASEAPP_DISABLE_NUMPY": "1"
    }
  },
  "cleanup-commands": [
    "/app/cleanup-BaseApp.sh"
  ],
  "modules": [
    {
      "name": "pomotux",
      "buildsystem": "simple",
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ],
      "build-commands": [
        "mkdir -p /app/share/pomotux /app/bin",
        "cp main.py /app/share/pomotux/",
        "cp -r pomotux /app/share/pomotux/",
        "install -Dm755 packaging/flatpak/pomotux-wrapper.sh /app/bin/pomotux",
        "sed s/^Icon=.*/Icon=io.github.imamAtif.PomoTux/ packaging/io.github.pomotux.desktop > /app/share/applications/io.github.imamAtif.PomoTux.desktop",
        "for s in 16 32 48 64 128 256 512; do install -Dm644 packaging/icons/hicolor/${s}x${s}/apps/io.github.pomotux.png /app/share/icons/hicolor/${s}x${s}/apps/io.github.imamAtif.PomoTux.png; done",
        "install -Dm644 packaging/icons/io.github.pomotux.svg /app/share/icons/hicolor/scalable/apps/io.github.imamAtif.PomoTux.svg"
      ]
    }
  ]
}
